     # Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}: {
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.kernelModules = ["asus_nb_wmi" "asus_wmi" "hid_asus" "kvm-amd" "xhci_pci" "usbhid"];

  boot.kernelParams = ["modprobe.blacklist=ucsi_acpi" "usbcore.autosuspend=-1" "iommu=pt"];
  boot.initrd.availableKernelModules = [
    "i2c_designware_pci" "i2c_designware_core" "i2c_hid_acpi"
    "evdev" "hid_asus" "usbhid" "i8042" "atkbd" "nvme" "xhci_pci" "thunderbolt" "sdhci_pci"];
  boot.extraModulePackages = [];

  boot.initrd.systemd.enable = true;                    
  boot.kernelPackages = pkgs.linuxPackages;     

services.udev.extraRules = ''
  # Disable USB autosuspend by forcing the power control to 'on' for all USB devices
  ACTION=="add", SUBSYSTEM=="usb", TEST=="power/control", ATTR{power/control}="on"
  
  # Ensure the power autosuspend delay is disabled (-1)
  ACTION=="add", SUBSYSTEM=="usb", TEST=="power/autosuspend", ATTR{power/autosuspend}="-1"
'';

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
